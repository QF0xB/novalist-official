{
  "name": "novalist",
  "version": "3.6.0",
  "description": "Novalist - a writing app for novelists",
  "main": "./out/main/index.js",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prototype:editor:build": "tsc -p prototypes/in-app-editor/tsconfig.json && vite build --config prototypes/in-app-editor/vite.config.ts",
    "prototype:editor:test": "npm run prototype:editor:build && playwright test --config prototypes/in-app-editor/playwright.config.ts",
    "scene-editor:build": "tsc -p src/sceneEditor/tsconfig.json && vite build --config src/sceneEditor/vite.config.ts",
    "predev": "npm run scene-editor:build",
    "prebuild": "npm run scene-editor:build",
    "prototype:html": "vite --config prototypes/html-yjs/vite.config.ts",
    "prototype:html:build": "tsc -p prototypes/html-yjs/tsconfig.json && vite build --config prototypes/html-yjs/vite.config.ts",
    "prototype:html:test": "playwright test --config prototypes/html-yjs/playwright.config.ts",
    "postinstall": "node scripts/patch-electron-builder.cjs && node scripts/sync-editor-sanitizer.mjs && install-electron",
    "test:packaging": "node --test scripts/patch-electron-builder.test.cjs",
    "test:transport": "node --experimental-strip-types --test scripts/*.test.mjs",
    "dev": "electron-vite dev",
    "build": "node scripts/sync-editor-sanitizer.mjs && electron-vite build",
    "build:mobile": "node scripts/sync-editor-sanitizer.mjs && vite build --config vite.mobile.config.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p src/sceneModel/tsconfig.json",
    "package": "npm run build && npm run backend:publish && electron-builder --config electron-builder.yml",
    "backend:publish": "node scripts/publish-backend.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "dompurify": "3.4.16",
    "electron-updater": "^6.8.9",
    "harper.js": "2.7.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^42.11.8",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.3",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "typescript": "^7.0.2",
    "vite": "^7.0.2",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "author": "Novalist",
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  },
  "homepage": "https://github.com/Drommedhar/novalist-official",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Drommedhar/novalist-official.git"
  }
}
